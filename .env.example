# Copy to .env and adjust. NEVER commit a real .env.
PORT=3000
NODE_ENV=development
# sqlite (sandbox default) or postgres (docker target)
DB_DRIVER=sqlite
SQLITE_PATH=./data/taskflow.db
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
# JWT_SECRET — WAJIB. Tidak ada nilai default: server gagal start bila kosong
# (temuan B5-F7: secret default yang tertulis di repo = siapa pun bisa
# menempa token admin). Isi string acak panjang, mis. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
LOG_LEVEL=info
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
