# Copy to .env and adjust. NEVER commit a real .env.
PORT=3000
NODE_ENV=development
# sqlite (sandbox default) or postgres (docker target)
DB_DRIVER=sqlite
SQLITE_PATH=./data/taskflow.db
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LOG_LEVEL=info
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
